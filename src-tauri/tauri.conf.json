{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TomatoDesk",
  "version": "0.1.0",
  "identifier": "com.tomatodesk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TomatoDesk",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560
      },
      {
        "label": "quick-capture",
        "title": "快速收集 · TomatoDesk",
        "width": 520,
        "height": 320,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
