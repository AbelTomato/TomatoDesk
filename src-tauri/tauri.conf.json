{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TomatoDesk",
  "version": "0.4.0",
  "identifier": "com.tomatodesk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TomatoDesk",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560
      },
      {
        "label": "quick-capture",
        "title": "快速收集 · TomatoDesk",
        "width": 520,
        "height": 380,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AbelTomato/TomatoDesk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5RDkzRjMyNEM3REJBREMKUldUY3VuMU1Nai9aMlE0QVQ4QXVsRlpiU242d2kxZ2RrMWxuUHJmRlFYdVI3NGloVkhiUEtMdGEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "AbelTomato",
    "copyright": "Copyright © 2026 AbelTomato",
    "category": "Utility",
    "shortDescription": "本地优先的个人信息收件箱",
    "longDescription": "使用 TomatoDesk 在本机收集链接和笔记，并整理 GitHub 更新。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "TomatoDesk",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
